# Copy file này thành .env.local và điền giá trị từ Supabase project
# (Settings → API). Khi bỏ trống, app hiện màn hình hướng dẫn kết nối.

# --- Supabase (bắt buộc) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase service role (server-only, cần cho IPN VNPay) ---
# Lấy ở Supabase → Settings → API → service_role key. KHÔNG bắt đầu bằng NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- VNPay QR (tuỳ chọn) ---
# Đăng ký sandbox tại https://sandbox.vnpayment.vn/devreg/ để nhận TmnCode + HashSecret.
# Bật thanh toán VNPay trên UI:
NEXT_PUBLIC_VNPAY_ENABLED=true
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# sandbox (mặc định) hoặc production
VNPAY_ENV=sandbox
# Cố định domain khi chạy nhiều môi trường (tuỳ chọn, VD: https://dorm-utility-app.vercel.app)
NEXT_PUBLIC_APP_URL=

# --- Casso (tuỳ chọn) — tự xác nhận VietQR qua webhook realtime ---
# Đăng ký tại https://app.casso.vn → kết nối tài khoản ngân hàng → tạo Webhook
# với URL https://<domain>/api/payment/casso/webhook → copy Secure Token:
NEXT_PUBLIC_CASSO_ENABLED=true
CASSO_SECURE_TOKEN=
